{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ayushsanghavi/ai-scraper/schema/document_schema.json",
  "title": "AI Document Object",
  "description": "Normalized AI-ready document generated by the scraping pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "doc_id",
    "source",
    "url",
    "title",
    "body_text",
    "fetched_at",
    "word_count",
    "char_count",
    "quality_signals",
    "tags",
    "raw_metadata",
    "links_out_internal"
  ],
  "properties": {
    "doc_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable unique identifier for deduplication and indexing."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Source system or domain name."
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Canonical document URL."
    },
    "title": {
      "type": "string",
      "description": "Clean document title."
    },
    "body_text": {
      "type": "string",
      "description": "Main cleaned textual content for AI workflows."
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of fetch time."
    },
    "language": {
      "type": ["string", "null"],
      "minLength": 2,
      "description": "Language code inferred from body_text."
    },
    "content_type": {
      "type": ["string", "null"],
      "enum": ["doc_page", "article", "listing", "unknown", null],
      "description": "Heuristic classification of page intent."
    },
    "word_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of words in body_text."
    },
    "char_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of characters in body_text."
    },
    "reading_time_minutes": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Estimated reading time in minutes."
    },
    "is_mostly_code": {
      "type": ["boolean", "null"],
      "description": "True when content appears code-heavy."
    },
    "quality_signals": {
      "type": "object",
      "description": "Additional numeric signals useful for ranking/filtering.",
      "additionalProperties": {
        "type": "number"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Label tags assigned during enrichment."
    },
    "raw_metadata": {
      "type": "object",
      "description": "Auxiliary metadata captured from the page.",
      "additionalProperties": true
    },
    "links_out_internal": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "description": "Internal links extracted from the page."
    }
  }
}
